/* fonts embedded into exported files (fetched once from Google Fonts) */
const FONT_Q = {Caveat:'Caveat:wght@700', Oswald:'Oswald:wght@700', Inter:'Inter:wght@700'};
const FONT_CSS = {};
async function loadFontCss(fam){
  if(FONT_CSS[fam] !== undefined) return;
  try{
    const css = await (await fetch('https://fonts.googleapis.com/css2?family='+FONT_Q[fam]+'&display=block')).text();
    const block = css.split('/*').find(b => /^\s*latin\s*\*\//.test(b)) || css;
    const url = (block.match(/url\((https:[^)]+\.woff2)\)/) || [])[1];
    const buf = await (await fetch(url)).arrayBuffer();
    let bin=''; const u=new Uint8Array(buf); for(let i=0;i<u.length;i+=0x8000) bin+=String.fromCharCode.apply(null,u.subarray(i,i+0x8000));
    FONT_CSS[fam] = "@font-face{font-family:'"+fam+"';font-weight:700;src:url(data:font/woff2;base64,"+btoa(bin)+") format('woff2')}";
  }catch(e){ FONT_CSS[fam] = ''; }
}
