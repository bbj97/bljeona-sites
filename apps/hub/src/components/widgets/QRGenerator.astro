---
// QR-Code Generator – self-contained component.
// Deps: npm i qrcode-generator @fontsource/caveat @fontsource/oswald @fontsource/inter
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/caveat/700.css';
import '@fontsource/oswald/700.css';
---
<div class="qrg">
  <nav class="stepper" id="stepper"></nav>
  
  <div class="wrap">
    <main class="left" id="left"></main>
    <aside class="right">
      <div class="sticky">
        <h2 class="pv-title">Vorschau</h2>
        <div class="pv" id="pv"></div>
        <div class="meta" id="meta"></div>
        <div id="warnBox"></div>
        <div class="quick">
          <button class="ghost" data-quick="png">PNG</button>
          <button class="ghost" data-quick="svg">SVG</button>
          <button class="ghost" data-quick="jpg">JPG</button>
        </div>
      </div>
    </aside>
  </div>
  
  <div class="modal" id="modal">
    <div class="sheet" id="sheet"></div>
  </div>
  <div class="toast" id="toast"></div>
</div>

<style is:global>
.qrg{
  --ink:#141414; --muted:#7a7a7a; --line:#e7e7e7; --soft:#f4f4f4; --card:#fff; --bg:#fafafa;
  --blue:#2563d0; --blue-h:#1f55b4; --radius:18px;
}
.qrg, .qrg *{box-sizing:border-box}
.qrg{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif;font-size:15px;-webkit-font-smoothing:antialiased}
.qrg button,.qrg input,.qrg select,.qrg textarea{font:inherit;color:inherit}
.qrg button{cursor:pointer}

/* stepper */
.qrg .stepper{display:flex;align-items:center;gap:18px;padding:22px clamp(16px,6vw,140px);border-bottom:1px solid var(--line);background:#fff;position:sticky;top:0;z-index:5}
.qrg .step{display:flex;align-items:center;gap:12px;border:0;background:none;padding:0;color:var(--muted);font-size:16px;white-space:nowrap}
.qrg .step .dot{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:var(--soft);font-size:13px;font-weight:600;color:var(--muted)}
.qrg .step.done .dot{background:#ececec;color:var(--ink)}
.qrg .step.active{color:var(--ink);font-weight:500}
.qrg .step.active .dot{background:var(--ink);color:#fff}
.qrg .bar{flex:1;height:1px;background:var(--line);min-width:20px}

.qrg .wrap{display:grid;grid-template-columns:minmax(0,1fr) 400px;gap:56px;padding:44px clamp(16px,6vw,140px) 60px;max-width:1500px;margin:0 auto}
.qrg .left{min-width:0}
.qrg .right{border-left:1px solid var(--line);padding-left:48px}
.qrg .sticky{position:sticky;top:110px}
.qrg h1{font-size:24px;font-weight:600;margin:0 0 28px;letter-spacing:-.01em}
.qrg h3{font-size:15px;font-weight:500;margin:28px 0 14px}
.qrg .sub{color:var(--muted);margin:-18px 0 26px}

/* type grid */
.qrg .types{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:14px}
.qrg .type{border:1px solid var(--line);background:#fff;border-radius:var(--radius);padding:20px 18px;text-align:left;display:flex;flex-direction:column;gap:12px;transition:.15s}
.qrg .type:hover{border-color:#bdbdbd;transform:translateY(-1px)}
.qrg .type.sel{border-color:var(--ink);box-shadow:0 0 0 1px var(--ink)}
.qrg .type svg{width:28px;height:28px}
.qrg .type b{font-weight:600}
.qrg .type span{color:var(--muted);font-size:13px;line-height:1.35}

/* forms */
.qrg .form{display:grid;grid-template-columns:1fr 1fr;gap:16px 18px;max-width:720px}
.qrg .form .full{grid-column:1/-1}
.qrg label.f{display:flex;flex-direction:column;gap:7px;font-size:13px;color:#444;font-weight:500}
.qrg .inp,.qrg select.inp,.qrg textarea.inp{border:1px solid #dcdcdc;border-radius:12px;padding:12px 14px;background:#fff;outline:none;font-size:15px;width:100%}
.qrg textarea.inp{min-height:120px;resize:vertical}
.qrg .inp:focus{border-color:var(--ink);box-shadow:0 0 0 3px #00000010}
.qrg .check{display:flex;align-items:center;gap:10px;font-size:14px}
.qrg .check input{width:18px;height:18px;accent-color:var(--ink)}

/* tabs & pills */
.qrg .tabs{display:flex;gap:40px;border-bottom:1px solid var(--line);margin-bottom:28px}
.qrg .tabs button{border:0;background:none;padding:0 0 14px;font-size:17px;color:var(--muted);border-bottom:2px solid transparent;margin-bottom:-1px}
.qrg .tabs button.on{color:var(--ink);border-color:var(--ink);font-weight:500}
.qrg .pills{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:28px}
.qrg .pill{border:1px solid var(--line);background:#fff;border-radius:999px;padding:12px 26px;font-size:16px;color:#666}
.qrg .pill.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.qrg .seg{display:inline-flex;border:1px solid var(--line);border-radius:12px;padding:3px;background:#fff;gap:2px;flex-wrap:wrap}
.qrg .seg button{border:0;background:none;padding:8px 14px;border-radius:9px;color:#555;font-size:14px}
.qrg .seg button.on{background:var(--ink);color:#fff}

/* frames grid */
.qrg .frames{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:14px}
.qrg .tile{aspect-ratio:1;border:1px solid var(--line);border-radius:16px;background:#fff;display:grid;place-items:center;padding:12px;transition:.12s}
.qrg .tile:hover{border-color:#bdbdbd}
.qrg .tile.sel{border:2px solid var(--ink);padding:11px}
.qrg .tile svg{width:100%;height:100%;display:block}
.qrg .tile.small{aspect-ratio:auto;height:78px;padding:10px}
.qrg .styles{display:grid;grid-template-columns:repeat(auto-fill,minmax(78px,1fr));gap:12px;max-width:560px}
.qrg .styles .tile{padding:14px}

.qrg .swatches{display:flex;gap:14px;flex-wrap:wrap}
.qrg .sw{display:flex;gap:6px;padding:9px;border:1px solid var(--line);border-radius:14px;background:#fff}
.qrg .sw.sel{border:2px solid var(--ink);padding:8px}
.qrg .sw i{width:44px;height:36px;border-radius:7px;display:block;border:1px solid #0000000f}

.qrg .colors{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px;max-width:760px}
.qrg .color{display:flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:14px;padding:10px 12px;background:#fff}
.qrg .color input[type=color]{width:40px;height:40px;border:0;padding:0;background:none;border-radius:10px;cursor:pointer}
.qrg .color input[type=color]::-webkit-color-swatch-wrapper{padding:0}
.qrg .color input[type=color]::-webkit-color-swatch{border:1px solid #0000001a;border-radius:10px}
.qrg .color .hex{border:0;outline:none;width:90px;font-size:14px;font-family:ui-monospace,monospace;text-transform:uppercase}
.qrg .color small{display:block;color:var(--muted);font-size:12px;margin-bottom:2px}
.qrg .row{display:flex;gap:18px;flex-wrap:wrap;align-items:center}

.qrg .drop{border:1.5px dashed #cfcfcf;border-radius:var(--radius);padding:34px;text-align:center;background:#fff;color:#666;max-width:560px;cursor:pointer;transition:.15s}
.qrg .drop.over{border-color:var(--ink);background:#f6f6f6}
.qrg .drop b{color:var(--ink)}
.qrg .logo-row{display:flex;gap:18px;align-items:center;margin-top:18px;max-width:560px}
.qrg .logo-row img{width:72px;height:72px;object-fit:contain;border:1px solid var(--line);border-radius:12px;background:#fff;padding:6px}
.qrg input[type=range]{accent-color:var(--ink);width:220px}

.qrg .foot{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:44px}
.qrg .back{width:54px;height:54px;border-radius:50%;border:1px solid var(--line);background:#fff;display:grid;place-items:center}
.qrg .back svg{width:22px}
.qrg .cta{flex:1;max-width:560px;margin-left:auto;border:0;background:var(--blue);color:#fff;border-radius:999px;height:56px;font-size:17px;font-weight:500;display:flex;align-items:center;justify-content:center;gap:12px;transition:.15s}
.qrg .cta:hover{background:var(--blue-h)}
.qrg .cta svg{width:22px}
.qrg .ghost{border:1px solid var(--line);background:#fff;border-radius:999px;padding:11px 20px;font-size:14px}

/* preview */
.qrg .pv-title{text-align:center;font-size:20px;font-weight:500;margin:0 0 40px}
.qrg .pv{background:#fff;border:1px solid var(--line);border-radius:22px;padding:30px;display:grid;place-items:center;aspect-ratio:1;box-shadow:0 1px 0 #00000005}
.qrg .pv.checker{background-color:#fff;background-image:linear-gradient(45deg,#f0f0f0 25%,transparent 25%),linear-gradient(-45deg,#f0f0f0 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#f0f0f0 75%),linear-gradient(-45deg,transparent 75%,#f0f0f0 75%);background-size:20px 20px;background-position:0 0,0 10px,10px -10px,-10px 0}
.qrg .pv svg{width:100%;height:100%;display:block}
.qrg .meta{margin-top:16px;font-size:13px;color:var(--muted);text-align:center;word-break:break-all;line-height:1.5}
.qrg .warn{margin-top:12px;background:#fff6e6;color:#8a5300;border:1px solid #f3dcb0;border-radius:12px;padding:10px 12px;font-size:13px;line-height:1.4}
.qrg .err{background:#fdecec;color:#9b1c1c;border-color:#f5c2c2}
.qrg .quick{display:flex;gap:10px;justify-content:center;margin-top:18px}

/* modal */
.qrg .modal{position:fixed;inset:0;background:#0006;display:none;place-items:center;z-index:20;padding:20px}
.qrg .modal.on{display:grid}
.qrg .sheet{background:#fff;border-radius:22px;padding:28px;width:min(460px,100%);box-shadow:0 20px 60px #0003}
.qrg .sheet h2{margin:0 0 18px;font-size:20px;font-weight:600}
.qrg .sheet .lbl{font-size:13px;color:#555;font-weight:500;margin:18px 0 8px}
.qrg .sheet .actions{display:flex;gap:10px;justify-content:flex-end;margin-top:26px}
.qrg .sheet .cta{height:48px;font-size:15px;max-width:none;flex:none;padding:0 24px;margin:0}
.qrg .fallback img{width:100%;border:1px solid var(--line);border-radius:12px;margin-top:10px;background:#fff}
.qrg .toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%) translateY(20px);background:var(--ink);color:#fff;padding:12px 18px;border-radius:12px;font-size:14px;opacity:0;transition:.25s;pointer-events:none;z-index:30}
.qrg .toast.on{opacity:1;transform:translateX(-50%)}
.qrg .hidden{display:none!important}

@media (max-width:1000px){
  .qrg .wrap{grid-template-columns:1fr;gap:30px}
  .qrg .right{border-left:0;padding-left:0;order:-1}
  .qrg .sticky{position:static}
  .qrg .pv{max-width:340px;margin:0 auto}
  .qrg .pv-title{margin-bottom:16px}
  .qrg .step .lbl-t{display:none}
  .qrg .step.active .lbl-t{display:inline}
  .qrg .form{grid-template-columns:1fr}
}
</style>

<script>
// @ts-nocheck — plain-JS widget; runtime-tested, types intentionally skipped
import qrcode from 'qrcode-generator';
import caveatUrl from '@fontsource/caveat/files/caveat-latin-700-normal.woff2?url';
import oswaldUrl from '@fontsource/oswald/files/oswald-latin-700-normal.woff2?url';
import interUrl from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';
qrcode.stringToBytes = (s: string) => Array.from(new TextEncoder().encode(s)); // UTF-8 (works with v1 and v2)

const root = document.querySelector('.qrg');
if (root && !root.dataset.ready) { root.dataset.ready = '1'; init(root); }

function init(root){
/* fonts embedded into exported SVG/PNG */
const FONT_URLS = {Caveat: caveatUrl, Oswald: oswaldUrl, Inter: interUrl};
const FONT_CSS = {};
async function loadFontCss(fam){
  if(FONT_CSS[fam] !== undefined) return;
  try{
    const buf = await (await fetch(FONT_URLS[fam])).arrayBuffer();
    let bin=''; const u=new Uint8Array(buf); for(let i=0;i<u.length;i+=0x8000) bin+=String.fromCharCode.apply(null,u.subarray(i,i+0x8000));
    FONT_CSS[fam] = `@font-face{font-family:'${fam}';font-weight:700;src:url(data:font/woff2;base64,${btoa(bin)}) format('woff2')}`;
  }catch(e){ FONT_CSS[fam]=''; }
}
let uidN = 0;

/* ---------- helpers ---------- */
const $ = (s, r = root) => r.querySelector(s);
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const f = v => Math.round(v * 100) / 100;
const icons = {
  url:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>',
  text:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M5 6h14M5 10h14M5 14h10M5 18h7"/></svg>',
  email:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M4 7l8 6 8-6"/></svg>',
  phone:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a1 1 0 01-1 1A16 16 0 014 5a1 1 0 011-1z"/></svg>',
  sms:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M4 5h16v11H9l-5 4z"/><path d="M8 10h.01M12 10h.01M16 10h.01" stroke-width="2.4" stroke-linecap="round"/></svg>',
  wifi:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M2.5 9a14 14 0 0119 0M5.5 12.5a9.5 9.5 0 0113 0M8.5 16a5 5 0 017 0"/><circle cx="12" cy="19" r=".8" fill="currentColor"/></svg>',
  vcard:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><circle cx="9" cy="11" r="2.2"/><path d="M5.8 16.5a3.6 3.6 0 016.4 0M14.5 10h3.5M14.5 13.5h3.5"/></svg>',
  geo:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0113 0c0 5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/></svg>',
};

/* ---------- content types ---------- */
const enc = encodeURIComponent;
const wifiEsc = s => String(s).replace(/([\\;,:"])/g, '\\$1');
const TYPES = {
  url:   {name:'Website', desc:'Link zu einer beliebigen Webseite',
          fields:[{k:'url',label:'Website-URL',ph:'https://beispiel.de',full:1}],
          encode:d=>{ let u=(d.url||'').trim(); if(!u) return ''; if(!/^[a-z][a-z0-9+.-]*:/i.test(u)) u='https://'+u; return u; },
          sample:'https://beispiel.de'},
  text:  {name:'Text', desc:'Freier Text, Notiz oder Code',
          fields:[{k:'text',label:'Text',area:1,full:1,ph:'Dein Text …'}], encode:d=>d.text||'', sample:'Hallo!'},
  email: {name:'E-Mail', desc:'Vorausgefüllte E-Mail öffnen',
          fields:[{k:'to',label:'Empfänger',ph:'name@firma.de',full:1},{k:'subject',label:'Betreff',full:1},{k:'body',label:'Nachricht',area:1,full:1}],
          encode:d=>{ if(!d.to) return ''; const q=[]; if(d.subject) q.push('subject='+enc(d.subject)); if(d.body) q.push('body='+enc(d.body)); return 'mailto:'+d.to.trim()+(q.length?'?'+q.join('&'):''); },
          sample:'mailto:name@firma.de'},
  phone: {name:'Telefon', desc:'Nummer direkt anrufen',
          fields:[{k:'tel',label:'Telefonnummer',ph:'+49 30 1234567',full:1}],
          encode:d=>d.tel?'tel:'+d.tel.replace(/[^\d+*#]/g,''):'', sample:'tel:+49301234567'},
  sms:   {name:'SMS', desc:'SMS mit vorgegebenem Text',
          fields:[{k:'tel',label:'Telefonnummer',ph:'+49 170 1234567',full:1},{k:'msg',label:'Nachricht',area:1,full:1}],
          encode:d=>d.tel?`SMSTO:${d.tel.replace(/[^\d+]/g,'')}:${d.msg||''}`:'', sample:'SMSTO:+491701234567:'},
  wifi:  {name:'WLAN', desc:'Ohne Passwort-Tippen verbinden',
          fields:[{k:'ssid',label:'Netzwerkname (SSID)',ph:'Mein-WLAN'},{k:'pass',label:'Passwort'},
                  {k:'auth',label:'Verschlüsselung',select:[['WPA','WPA/WPA2/WPA3'],['WEP','WEP'],['nopass','Keine']]},
                  {k:'hidden',label:'Verstecktes Netzwerk',check:1}],
          encode:d=>d.ssid?`WIFI:T:${d.auth||'WPA'};S:${wifiEsc(d.ssid)};${(d.auth||'WPA')!=='nopass'?`P:${wifiEsc(d.pass||'')};`:''}${d.hidden?'H:true;':''};`:'',
          sample:'WIFI:T:WPA;S:Mein-WLAN;P:passwort;;'},
  vcard: {name:'Visitenkarte', desc:'Kontakt als vCard speichern',
          fields:[{k:'first',label:'Vorname'},{k:'last',label:'Nachname'},{k:'org',label:'Firma'},{k:'title',label:'Position'},
                  {k:'tel',label:'Telefon'},{k:'mobile',label:'Mobil'},{k:'email',label:'E-Mail'},{k:'web',label:'Website'},
                  {k:'street',label:'Straße',full:1},{k:'zip',label:'PLZ'},{k:'city',label:'Ort'},{k:'country',label:'Land'}],
          encode:d=>{
            if(!d.first && !d.last && !d.org) return '';
            const L=['BEGIN:VCARD','VERSION:3.0',`N:${d.last||''};${d.first||''};;;`,`FN:${[d.first,d.last].filter(Boolean).join(' ')||d.org}`];
            if(d.org) L.push('ORG:'+d.org); if(d.title) L.push('TITLE:'+d.title);
            if(d.tel) L.push('TEL;TYPE=WORK,VOICE:'+d.tel); if(d.mobile) L.push('TEL;TYPE=CELL:'+d.mobile);
            if(d.email) L.push('EMAIL:'+d.email); if(d.web) L.push('URL:'+d.web);
            if(d.street||d.city||d.zip||d.country) L.push(`ADR;TYPE=WORK:;;${d.street||''};${d.city||''};;${d.zip||''};${d.country||''}`);
            L.push('END:VCARD'); return L.join('\n'); },
          sample:'BEGIN:VCARD\nVERSION:3.0\nN:Muster;Max;;;\nFN:Max Muster\nEND:VCARD'},
  geo:   {name:'Standort', desc:'Koordinaten in der Karten-App',
          fields:[{k:'lat',label:'Breitengrad',ph:'52.5163'},{k:'lng',label:'Längengrad',ph:'13.3777'}],
          encode:d=>(d.lat&&d.lng)?`geo:${d.lat.trim().replace(',','.')},${d.lng.trim().replace(',','.')}`:'', sample:'geo:52.5163,13.3777'},
};

/* ---------- design options ---------- */
const TEMPLATES = [
  ['#000000','#000000','#000000'],
  ['#12382b','#2a6b6b','#2a6b6b'],
  ['#2b1a0c','#2b1a0c','#ad3f1d'],
  ['#060a2e','#1534c8','#1534c8'],
  ['#3a0d3f','#8e2c8a','#c2399b'],
  ['#1b1b1b','#e0452b','#e0452b'],
  ['#0b3a5c','#0b3a5c','#f2a516'],
  ['#2e2e2e','#6d6d6d','#a8a8a8'],
];
const FONTS = {script:{fam:'Caveat',w:700,name:'Handschrift'}, sans:{fam:'Inter',w:700,name:'Modern'}, cond:{fam:'Oswald',w:700,name:'Kompakt'}};
const FRAMES = ['none','bar','bubble','tab','brackets','side','outline','stamp','ribbon','clipboard','phone','circle'];
const FRAME_FONT = {brackets:'script', side:'cond', bar:'sans', bubble:'sans', tab:'sans', outline:'sans', stamp:'cond', ribbon:'cond', clipboard:'sans', phone:'sans', circle:'cond'};

const DEFAULT = {
  step:1, type:'url', data:{url:''}, tab:'frame',
  frame:'brackets', label:'Scan mich!', font:'script',
  dots:'#2b1a0c', eyes:'#2b1a0c', frameColor:'#ad3f1d', bg:'#ffffff', transparent:false,
  textAuto:true, textColor:'#ffffff', tpl:2,
  dotStyle:'square', eyeStyle:'square', ec:'M',
  logo:null, logoSize:0.22, logoBg:true,
  dlFmt:'png', dlSize:1024,
};
let S;
try { S = Object.assign({}, DEFAULT, JSON.parse(localStorage.getItem('qrgen-v1')||'{}')); } catch(e) { S = {...DEFAULT}; }
S.data = S.data || {};
let saveT; function save(){ clearTimeout(saveT); saveT=setTimeout(()=>{ try{ localStorage.setItem('qrgen-v1', JSON.stringify(S)); }catch(e){} }, 300); }

/* ---------- QR matrix ---------- */
function makeMatrix(text, ec){
  const q = qrcode(0, ec); q.addData(text, 'Byte'); q.make();
  const n = q.getModuleCount();
  return { n, on:(r,c)=> r>=0 && c>=0 && r<n && c<n && q.isDark(r,c) };
}

/* ---------- geometry ---------- */
function rr(x,y,w,h,R){ // per-corner rounded rect path, R=[tl,tr,br,bl]
  const [tl,tr,br,bl] = Array.isArray(R)?R:[R,R,R,R];
  return `M${f(x+tl)} ${f(y)}H${f(x+w-tr)}${tr?`A${f(tr)} ${f(tr)} 0 0 1 ${f(x+w)} ${f(y+tr)}`:''}V${f(y+h-br)}${br?`A${f(br)} ${f(br)} 0 0 1 ${f(x+w-br)} ${f(y+h)}`:''}H${f(x+bl)}${bl?`A${f(bl)} ${f(bl)} 0 0 1 ${f(x)} ${f(y+h-bl)}`:''}V${f(y+tl)}${tl?`A${f(tl)} ${f(tl)} 0 0 1 ${f(x+tl)} ${f(y)}`:''}Z`;
}
function circ(cx,cy,r){ return `M${f(cx-r)} ${f(cy)}a${f(r)} ${f(r)} 0 1 0 ${f(2*r)} 0a${f(r)} ${f(r)} 0 1 0 ${f(-2*r)} 0Z`; }

function moduleShape(style, M, r, c, X, Y, s){
  switch(style){
    case 'dots':    return circ(X+s/2, Y+s/2, s*0.46);
    case 'rounded': { const k=s*0.9, o=(s-k)/2; return rr(X+o,Y+o,k,k,s*0.3); }
    case 'diamond': { const h=s*0.62, cx=X+s/2, cy=Y+s/2; return `M${f(cx)} ${f(cy-h)}L${f(cx+h)} ${f(cy)}L${f(cx)} ${f(cy+h)}L${f(cx-h)} ${f(cy)}Z`; }
    case 'fluid': {
      const u=M.on(r-1,c), d=M.on(r+1,c), l=M.on(r,c-1), rt=M.on(r,c+1), h=s/2;
      return rr(X,Y,s+.3,s+.3,[(!u&&!l)?h:0,(!u&&!rt)?h:0,(!d&&!rt)?h:0,(!d&&!l)?h:0]);
    }
    default: return `M${f(X)} ${f(Y)}h${f(s+.3)}v${f(s+.3)}h${f(-s-.3)}Z`;
  }
}

function eyePaths(style, X, Y, c, which){
  let R1,R2,R3;
  const leaf = (v,i) => { const a=[v,v,v,v]; a[i]=0; return a; };
  const sharp = {tl:2, tr:3, bl:1}[which];
  switch(style){
    case 'rounded': R1=c*2; R2=c*1.3; R3=c*0.9; break;
    case 'circle':  R1=c*3.5; R2=c*2.5; R3=c*1.5; break;
    case 'leaf':    R1=leaf(c*2.6,sharp); R2=leaf(c*1.8,sharp); R3=leaf(c*1.3,sharp); break;
    default: R1=R2=R3=0;
  }
  return { ring: rr(X,Y,7*c,7*c,R1)+rr(X+c,Y+c,5*c,5*c,R2), ball: rr(X+2*c,Y+2*c,3*c,3*c,R3) };
}

/* QR block incl. quiet zone. o: {dots,eyes,bg,card(bool),cardR,logo,...} */
function qrBlock(M, x, y, size, o){
  const pad = size*0.07, c = (size-2*pad)/M.n, ox=x+pad, oy=y+pad, n=M.n;
  let out = '';
  if(o.card && !o.transparent) out += `<path d="${rr(x,y,size,size,o.cardR||0)}" fill="${o.bg}"/>`;
  let hole=null;
  if(o.logo){
    let k = Math.round(n*o.logoSize); if((n-k)%2) k++;
    const a=(n-k)/2; hole={a, b:a+k};
  }
  const finder=(r,cc)=>(r<7&&cc<7)||(r<7&&cc>=n-7)||(r>=n-7&&cc<7);
  let d='';
  for(let r=0;r<n;r++) for(let cc=0;cc<n;cc++){
    if(!M.on(r,cc) || finder(r,cc)) continue;
    if(hole && r>=hole.a && r<hole.b && cc>=hole.a && cc<hole.b) continue;
    d += moduleShape(o.dotStyle, M, r, cc, ox+cc*c, oy+r*c, c);
  }
  out += `<path d="${d}" fill="${o.dots}"/>`;
  for(const [which,rx,ry] of [['tl',0,0],['tr',n-7,0],['bl',0,n-7]]){
    const e = eyePaths(o.eyeStyle, ox+rx*c, oy+ry*c, c, which);
    out += `<path d="${e.ring}" fill="${o.eyes}" fill-rule="evenodd"/><path d="${e.ball}" fill="${o.eyes}"/>`;
  }
  if(hole){
    const hx=ox+hole.a*c, hs=(hole.b-hole.a)*c;
    if(o.logoBg) out += `<path d="${rr(hx,oy+hole.a*c,hs,hs,c*1.2)}" fill="${o.transparent?'#ffffff':o.bg}"/>`;
    const ins = hs*0.1;
    out += `<image href="${o.logo}" x="${f(hx+ins)}" y="${f(oy+hole.a*c+ins)}" width="${f(hs-2*ins)}" height="${f(hs-2*ins)}" preserveAspectRatio="xMidYMid meet"/>`;
  }
  return out;
}

/* ---------- text ---------- */
const mctx = document.createElement('canvas').getContext('2d');
function measure(str, font, size){ const F=FONTS[font]; mctx.font=`${F.w} ${size}px ${F.fam}`; return mctx.measureText(str).width; }
function fitSize(str, font, maxW, maxSize){ const w = measure(str, font, 100) || 1; return Math.min(maxSize, 100*maxW/w); }
function text(str, font, cx, cy, maxW, maxSize, color, anchor='middle'){
  if(!str) return '';
  const F=FONTS[font], s=fitSize(str,font,maxW,maxSize);
  const dy = font==='script' ? s*0.06 : s*0.02;
  return `<text x="${f(cx)}" y="${f(cy+dy)}" font-family="${F.fam}" font-weight="${F.w}" font-size="${f(s)}" fill="${color}" text-anchor="${anchor}" dominant-baseline="central">${esc(str)}</text>`;
}

/* ---------- colour utils ---------- */
function lum(hex){ const h=hex.replace('#',''); const v=[0,2,4].map(i=>{let x=parseInt(h.substr(i,2),16)/255; return x<=.03928?x/12.92:Math.pow((x+.055)/1.055,2.4);}); return .2126*v[0]+.7152*v[1]+.0722*v[2]; }
function contrast(a,b){ const x=lum(a), y=lum(b); return (Math.max(x,y)+.05)/(Math.min(x,y)+.05); }

/* ---------- frame composer ---------- */
function compose(M, st, mono){
  const Q = 600;
  const col = mono ? {dots:'#111',eyes:'#111',fc:'#111',bg:'#fff'} : {dots:st.dots, eyes:st.eyes, fc:st.frameColor, bg:st.bg};
  const transparent = !mono && st.transparent;
  const font = mono ? FRAME_FONT[st.frame] : st.font;
  const label = mono ? (st.frame==='brackets'?'scan me':'SCAN ME') : st.label;
  const bgFill = transparent ? '#ffffff' : col.bg;
  const onFrame = (!mono && !st.textAuto) ? st.textColor : (contrast(bgFill, col.fc) > 1.6 ? bgFill : (lum(col.fc)>.4?'#111111':'#ffffff'));
  const outside = (!mono && !st.textAuto) ? st.textColor : col.fc;
  const base = {dots:col.dots, eyes:col.eyes, bg:col.bg, transparent, dotStyle:mono?'square':st.dotStyle, eyeStyle:mono?'square':st.eyeStyle,
                logo: mono?null:st.logo, logoSize:st.logoSize, logoBg:st.logoBg, card:true};
  const q = (x,y,s,extra={}) => qrBlock(M,x,y,s,{...base,...extra});
  let W, H, body='', defs=''; const uid='qrg'+(++uidN);
  const P = 36;
  switch(st.frame){
    case 'bar': {
      W=Q+2*P; H=Q+2*P+140;
      body = `<path d="${rr(0,0,W,H,48)}" fill="${col.fc}"/>` + q(P,P,Q,{cardR:26}) + text(label,font,W/2,Q+P+(H-Q-P)/2,W-90,92,onFrame);
      break; }
    case 'bubble': {
      W=Q+40; const y0=Q+40+44; H=y0+150;
      body = `<path d="${rr(8,8,Q+24,Q+24,36)}" fill="${transparent?'none':col.bg}" stroke="${col.fc}" stroke-width="16"/>` + q(20,20,Q,{card:false})
           + `<path d="${rr(0,y0,W,150,40)}M${W/2-42} ${y0+1}L${W/2} ${y0-36}L${W/2+42} ${y0+1}Z" fill="${col.fc}"/>`
           + text(label,font,W/2,y0+75,W-90,90,onFrame);
      break; }
    case 'tab': {
      const th=108; W=Q+2*P; H=th+Q+2*P;
      body = `<path d="${rr(0,0,W*0.66,th+50,[34,34,0,0])}" fill="${col.fc}"/><path d="${rr(0,th,W,Q+2*P,[0,40,40,40])}" fill="${col.fc}"/>`
           + q(P,th+P,Q,{cardR:22}) + text(label,font,W*0.33,th/2+10,W*0.66-70,68,onFrame);
      break; }
    case 'brackets': {
      const Pb=58, sw=18, L=150, r=56, h=sw/2; W=Q+2*Pb; const B=W; H=B+175;
      const br = (a,b,dx,dy)=>`M${a} ${b+dy*L}V${b+dy*r}A${r} ${r} 0 0 ${dx*dy>0?1:0} ${a+dx*r} ${b}H${a+dx*L}`;
      body = `<g fill="none" stroke="${col.fc}" stroke-width="${sw}" stroke-linecap="round">`
           + `<path d="${br(h,h,1,1)}"/><path d="${br(W-h,h,-1,1)}"/><path d="${br(h,B-h,1,-1)}"/><path d="${br(W-h,B-h,-1,-1)}"/></g>`
           + `<path d="${rr(Pb,Pb,Q,Q,46)}" fill="${transparent?'none':col.bg}" stroke="${col.fc}" stroke-width="26"/>`
           + q(Pb+30,Pb+30,Q-60,{card:false})
           + text(label,font,W/2,B+88,W-60,150,outside);
      break; }
    case 'side': {
      W=Q+2*P+380; H=Q+2*P;
      body = `<path d="${rr(0,0,W,H,44)}" fill="${col.fc}"/>` + q(P,P,Q,{cardR:22});
      const words = (label||'').split(/\s+/).filter(Boolean); const lines=[];
      if(words.length<=3) lines.push(...words); else { const half=Math.ceil(words.length/2); lines.push(words.slice(0,half).join(' '), words.slice(half).join(' ')); }
      const cx = Q+P+(W-Q-P)/2, maxW=300;
      const sizes = lines.map(l=>fitSize(l,font,maxW,220)); const s=Math.min(...sizes, (H-80)/Math.max(1,lines.length)/1.05);
      const total = s*1.05*lines.length; let y = H/2-total/2+s*1.05/2;
      for(const l of lines){ body += text(l,font,cx,y,maxW,s,onFrame); y+=s*1.05; }
      break; }
    case 'outline': {
      W=Q+2*P+16; H=W+130;
      body = `<path d="${rr(7,7,W-14,H-14,40)}" fill="${transparent?'none':col.bg}" stroke="${col.fc}" stroke-width="14"/>`
           + q(P+8,P+8,Q,{card:false}) + `<path d="M40 ${W}H${W-40}" stroke="${col.fc}" stroke-width="6" stroke-linecap="round"/>`
           + text(label,font,W/2,W+58,W-100,78,outside);
      break; }
    case 'stamp': {
      W=Q+2*P+40; H=W+120; const rad=15, gap=46;
      let holes=''; for(let x=gap/2;x<W;x+=gap){ holes+=`<circle cx="${f(x)}" cy="0" r="${rad}"/><circle cx="${f(x)}" cy="${H}" r="${rad}"/>`; }
      for(let y=gap/2;y<H;y+=gap){ holes+=`<circle cx="0" cy="${f(y)}" r="${rad}"/><circle cx="${W}" cy="${f(y)}" r="${rad}"/>`; }
      defs += `<mask id="${uid}s"><rect width="${W}" height="${H}" fill="#fff"/><g fill="#000">${holes}</g></mask>`;
      body = `<rect width="${W}" height="${H}" fill="${col.fc}" mask="url(#${uid}s)"/>` + q(P+20,P+20,Q,{cardR:8})
           + text(label,font,W/2,W+40,W-120,90,onFrame);
      break; }
    case 'ribbon': {
      W=Q+40+120; const cx0=60; const y=Q+30; H=y+170;
      body = `<path d="${rr(cx0+8,8,Q+24,Q+24,30)}" fill="${transparent?'none':col.bg}" stroke="${col.fc}" stroke-width="16"/>` + q(cx0+20,20,Q,{card:false})
           + `<path d="M0 ${y+34}H90V${y+164}H0L34 ${y+99}Z M${W} ${y+34}H${W-90}V${y+164}H${W}L${W-34} ${y+99}Z" fill="${col.fc}"/>`
           + `<path d="M0 ${y+34}H90V${y+164}H0L34 ${y+99}Z M${W} ${y+34}H${W-90}V${y+164}H${W}L${W-34} ${y+99}Z" fill="#000" opacity=".28"/>`
           + `<path d="M50 ${y+130}L90 ${y+164}V${y+130}Z M${W-50} ${y+130}L${W-90} ${y+164}V${y+130}Z" fill="#000" opacity=".45"/>`
           + `<rect x="50" y="${y}" width="${W-100}" height="130" fill="${col.fc}"/>`
           + text(label,font,W/2,y+65,W-170,88,onFrame);
      break; }
    case 'clipboard': {
      W=Q+2*P+20; const top=40; H=top+W+130;
      body = `<path d="${rr(0,top,W,H-top,34)}" fill="${col.fc}"/>`
           + `<path d="${rr(W/2-120,0,240,92,26)}" fill="${col.fc}" stroke="${bgFill}" stroke-width="10"/><circle cx="${W/2}" cy="34" r="14" fill="${bgFill}"/>`
           + q(P+10,top+P+50,Q,{cardR:14}) + text(label,font,W/2,top+P+50+Q+(H-(top+P+50+Q))/2,W-100,82,onFrame);
      break; }
    case 'phone': {
      const sp=48; W=Q+2*sp; const top=96; H=top+Q+150;
      body = `<path d="${rr(0,0,W,H,72)}" fill="${col.fc}"/>`
           + [0,1,2].map(i=>`<circle cx="${70+i*38}" cy="${top/2+4}" r="11" fill="${bgFill}"/>`).join('')
           + q(sp,top,Q,{cardR:26}) + text(label,font,W/2,top+Q+75,W-110,80,onFrame);
      break; }
    case 'circle': {
      const inner = Q*0.707+18, outer = inner+120; W=H=2*outer; const C=outer;
      const tr=(inner+outer)/2, circumference=2*Math.PI*tr, fs=64;
      const unit = (label||'SCAN ME') + '  •  ';
      const uw = measure(unit, font, fs) || 1;
      const reps = Math.max(1, Math.floor(circumference*0.96/uw));
      const str = unit.repeat(reps);
      defs += `<path id="${uid}r" d="M${C-tr} ${C}A${tr} ${tr} 0 1 1 ${C+tr} ${C}A${tr} ${tr} 0 1 1 ${C-tr} ${C}"/>`;
      const F=FONTS[font];
      body = `<circle cx="${C}" cy="${C}" r="${outer}" fill="${col.fc}"/>` + (transparent?'':`<circle cx="${C}" cy="${C}" r="${inner}" fill="${col.bg}"/>`)
           + q(C-Q/2,C-Q/2,Q,{card:false})
           + `<text font-family="${F.fam}" font-weight="${F.w}" font-size="${fs}" fill="${onFrame}" dominant-baseline="central"><textPath href="#${uid}r" textLength="${f(circumference-4)}" lengthAdjust="spacing">${esc(str)}</textPath></text>`;
      break; }
    default: {
      W=Q; H=Q; body = q(0,0,Q,{cardR:0});
    }
  }
  return {W, H, inner:(defs?`<defs>${defs}</defs>`:'')+body};
}

function svgString(st, M, {mono=false, exportFonts=false, w, h}={}){
  const {W,H,inner} = compose(M, st, mono);
  const style = exportFonts ? `<style>${FONT_CSS[FONTS[st.font].fam]||''}</style>` : '';
  return `<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 ${W} ${H}"${w?` width="${w}" height="${h}"`:''}>${style}${inner}</svg>`;
}

/* ---------- state → content ---------- */
let current = {M:null, text:'', error:null, sample:false};
function computeContent(){
  const T = TYPES[S.type];
  let t = ''; try { t = T.encode(S.data||{}); } catch(e){}
  const sample = !t; if(sample) t = T.sample;
  const ec = S.logo ? 'H' : S.ec;
  try { current = {M:makeMatrix(t, ec), text:t, error:null, sample, ec}; }
  catch(e){ current = {M:current.M, text:t, error:'Der Inhalt ist zu lang für einen QR-Code. Bitte kürzen.', sample, ec}; }
}

/* ---------- rendering UI ---------- */
function renderStepper(){
  const steps=['QR-Typ wählen','Inhalt erstellen','Anpassen & herunterladen'];
  const check='<svg viewBox="0 0 24 24" width="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
  $('#stepper').innerHTML = steps.map((s,i)=>{
    const n=i+1, cls = n===S.step?'active':(n<S.step?'done':'');
    return (i?'<div class="bar"></div>':'')+`<button class="step ${cls}" data-step="${n}"><span class="dot">${n<S.step?check:n}</span><span class="lbl-t">${s}</span></button>`;
  }).join('');
}

function field(fd){
  const v = (S.data||{})[fd.k] ?? '';
  const cls = fd.full?'f full':'f';
  if(fd.check) return `<label class="check ${fd.full?'full':''}"><input type="checkbox" data-k="${fd.k}" ${v?'checked':''}> ${fd.label}</label>`;
  if(fd.select) return `<label class="${cls}">${fd.label}<select class="inp" data-k="${fd.k}">${fd.select.map(([a,b])=>`<option value="${a}" ${(v||fd.select[0][0])===a?'selected':''}>${b}</option>`).join('')}</select></label>`;
  if(fd.area) return `<label class="${cls}">${fd.label}<textarea class="inp" data-k="${fd.k}" placeholder="${esc(fd.ph||'')}">${esc(v)}</textarea></label>`;
  return `<label class="${cls}">${fd.label}<input class="inp" data-k="${fd.k}" value="${esc(v)}" placeholder="${esc(fd.ph||'')}"></label>`;
}

const arrowL='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>';
const dlIcon='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 10.5l5 5 5-5M4.5 19.5h15"/></svg>';

let thumbCache = null;
function frameThumbs(){
  if(thumbCache) return thumbCache;
  const M = makeMatrix('SCAN', 'L');
  thumbCache = {};
  for(const fr of FRAMES){
    thumbCache[fr] = fr==='none'
      ? '<svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="30" fill="none" stroke="#666" stroke-width="7"/><path d="M25 82L75 18" stroke="#666" stroke-width="7" stroke-linecap="round"/></svg>'
      : svgString({...DEFAULT, frame:fr}, M, {mono:true});
  }
  return thumbCache;
}
function styleThumb(kind, val){
  const M = makeMatrix('QR', 'L');
  const st = {...DEFAULT, frame:'none', dots:'#111', eyes:'#111', bg:'#fff', logo:null};
  if(kind==='dot'){ st.dotStyle=val; st.eyeStyle='square'; } else { st.eyeStyle=val; st.dotStyle='square'; }
  const {W,H,inner} = compose(M, st, false);
  // crop to a corner for eye styles
  const vb = kind==='eye' ? `0 0 ${W*0.5} ${H*0.5}` : `${W*0.42} ${H*0.42} ${W*0.52} ${H*0.52}`;
  return `<svg viewBox="${vb}">${inner}</svg>`;
}

function renderLeft(){
  const L = $('#left');
  if(S.step===1){
    L.innerHTML = `<h1>Welchen QR-Code möchtest du erstellen?</h1>
      <div class="types">${Object.entries(TYPES).map(([k,T])=>`<button class="type ${k===S.type?'sel':''}" data-type="${k}">${icons[k]}<b>${T.name}</b><span>${T.desc}</span></button>`).join('')}</div>`;
    return;
  }
  if(S.step===2){
    const T = TYPES[S.type];
    L.innerHTML = `<h1>${T.name}: Inhalt eingeben</h1><p class="sub">${T.desc}. Die Vorschau aktualisiert sich live.</p>
      <div class="form">${T.fields.map(field).join('')}</div>
      <div class="foot"><button class="back" data-go="1" aria-label="Zurück">${arrowL}</button>
      <button class="cta" data-go="3">Weiter zum Design</button></div>`;
    return;
  }
  // step 3
  const tabs = [['frame','Rahmen'],['style','Anpassung'],['logo','Logo']];
  let panel='';
  if(S.tab==='frame'){
    const th = frameThumbs();
    panel = `<h3 style="margin-top:0">Rahmen um den QR-Code</h3>
      <div class="frames">${FRAMES.map(fr=>`<button class="tile ${fr===S.frame?'sel':''}" data-frame="${fr}" title="${fr}">${th[fr]}</button>`).join('')}</div>
      <div class="${S.frame==='none'?'hidden':''}">
        <h3>Rahmentext</h3>
        <div class="row"><input class="inp" id="label" value="${esc(S.label)}" maxlength="40" style="max-width:320px">
        <div class="seg">${Object.entries(FONTS).map(([k,F])=>`<button data-font="${k}" class="${S.font===k?'on':''}" style="font-family:${F.fam};font-weight:${F.w}">${F.name}</button>`).join('')}</div></div>
      </div>
      <h3>Farbvorlagen</h3>
      <div class="swatches">${TEMPLATES.map((t,i)=>`<button class="sw ${S.tpl===i?'sel':''}" data-tpl="${i}">${t.map((c,j)=>`<i style="background:${(i===0&&j===1)?'#fff':c}"></i>`).join('')}</button>`).join('')}</div>`;
  } else if(S.tab==='style'){
    const dots=[['square','Quadrat'],['rounded','Abgerundet'],['dots','Punkte'],['fluid','Fließend'],['diamond','Raute']];
    const eyes=[['square','Eckig'],['rounded','Abgerundet'],['circle','Rund'],['leaf','Blatt']];
    const colorInput=(k,l)=>`<div class="color"><input type="color" data-color="${k}" value="${S[k]}"><div><small>${l}</small><input class="hex" data-hex="${k}" value="${S[k]}" maxlength="7"></div></div>`;
    panel = `<h3 style="margin-top:0">Musterstil</h3>
      <div class="styles">${dots.map(([k,l])=>`<button class="tile ${S.dotStyle===k?'sel':''}" data-dot="${k}" title="${l}">${styleThumb('dot',k)}</button>`).join('')}</div>
      <h3>Ecken (Positionsmarker)</h3>
      <div class="styles">${eyes.map(([k,l])=>`<button class="tile ${S.eyeStyle===k?'sel':''}" data-eye="${k}" title="${l}">${styleThumb('eye',k)}</button>`).join('')}</div>
      <h3>Farben</h3>
      <div class="colors">${colorInput('dots','QR-Muster')}${colorInput('eyes','Ecken')}${colorInput('frameColor','Rahmen')}${colorInput('bg','Hintergrund')}
        ${S.textAuto?'':colorInput('textColor','Text')}</div>
      <div class="row" style="margin-top:14px">
        <label class="check"><input type="checkbox" id="transparent" ${S.transparent?'checked':''}> Transparenter Hintergrund</label>
        <label class="check"><input type="checkbox" id="textAuto" ${S.textAuto?'checked':''}> Textfarbe automatisch</label>
      </div>
      <h3>Fehlerkorrektur</h3>
      <div class="seg">${[['L','L · 7 %'],['M','M · 15 %'],['Q','Q · 25 %'],['H','H · 30 %']].map(([k,l])=>`<button data-ec="${k}" class="${(S.logo?'H':S.ec)===k?'on':''}" ${S.logo?'disabled':''}>${l}</button>`).join('')}</div>
      <p class="sub" style="margin:10px 0 0;font-size:13px">${S.logo?'Mit Logo wird automatisch Stufe H verwendet.':'Höhere Stufe = robuster, aber dichteres Muster.'}</p>`;
  } else {
    panel = `<h3 style="margin-top:0">Logo in der Mitte</h3>
      <div class="drop" id="drop"><b>Bild hochladen</b> oder hierher ziehen<br><span style="font-size:13px">PNG, JPG, SVG · wird lokal verarbeitet</span></div>
      <input type="file" id="file" accept="image/*" class="hidden">
      ${S.logo?`<div class="logo-row"><img src="${S.logo}" alt=""><div style="flex:1">
        <div class="f" style="font-size:13px;color:#444;font-weight:500;margin-bottom:6px">Größe</div>
        <input type="range" id="logoSize" min="0.12" max="0.3" step="0.01" value="${S.logoSize}">
        <label class="check" style="margin-top:10px"><input type="checkbox" id="logoBg" ${S.logoBg?'checked':''}> Hintergrund hinter Logo</label></div>
        <button class="ghost" id="logoDel">Entfernen</button></div>`:''}`;
  }
  L.innerHTML = `<h1>Gestalte deinen QR-Code</h1>
    <div class="pills">${tabs.map(([k,l])=>`<button class="pill ${S.tab===k?'on':''}" data-tab="${k}">${l}</button>`).join('')}</div>
    ${panel}
    <div class="foot"><button class="back" data-go="2" aria-label="Zurück">${arrowL}</button>
    <button class="cta" id="dlOpen">${dlIcon} QR herunterladen</button></div>`;
}

function renderPreview(){
  computeContent();
  const pv = $('#pv');
  if(current.M) pv.innerHTML = svgString(S, current.M);
  pv.classList.toggle('checker', !!S.transparent);
  const short = current.text.length>90 ? current.text.slice(0,90)+'…' : current.text;
  $('#meta').innerHTML = current.sample ? `<span style="color:#b07000">Beispielinhalt – gib im Schritt 2 deinen Inhalt ein.</span>`
    : `${esc(short)}<br>${current.M?`${current.M.n}×${current.M.n} Module · Korrektur ${current.ec}`:''}`;
  const w=[];
  if(current.error) w.push(`<div class="warn err">${current.error}</div>`);
  const bgc = S.transparent ? '#ffffff' : S.bg;
  const cr = Math.min(contrast(S.dots,bgc), contrast(S.eyes,bgc));
  if(cr < 3) w.push(`<div class="warn">Geringer Kontrast (${cr.toFixed(1)}:1) – der Code ist evtl. schwer scanbar. Dunkles Muster auf hellem Grund verwenden.</div>`);
  else if(lum(S.dots) > lum(bgc)) w.push(`<div class="warn">Helles Muster auf dunklem Grund wird nicht von allen Scannern gelesen.</div>`);
  $('#warnBox').innerHTML = w.join('');
}

function renderAll(){ renderStepper(); renderLeft(); renderPreview(); save(); }

/* ---------- events ---------- */
root.addEventListener('click', e=>{
  const b = e.target.closest('button'); if(!b) return;
  const d = b.dataset;
  if(d.step){ S.step=+d.step; renderAll(); return; }
  if(d.go){ S.step=+d.go; renderAll(); window.scrollTo({top:0}); return; }
  if(d.type){ if(S.type!==d.type){ S.type=d.type; S.data={}; } S.step=2; renderAll(); setTimeout(()=>$('#left .inp')?.focus(),0); return; }
  if(d.tab){ S.tab=d.tab; renderLeft(); save(); return; }
  if(d.frame){ S.frame=d.frame; if(FRAME_FONT[d.frame] && !S._fontTouched) S.font=FRAME_FONT[d.frame]; renderLeft(); renderPreview(); save(); return; }
  if(d.font){ S.font=d.font; S._fontTouched=true; renderLeft(); renderPreview(); save(); return; }
  if(d.tpl){ const t=TEMPLATES[+d.tpl]; S.tpl=+d.tpl; S.dots=t[0]; S.eyes=t[1]; S.frameColor=t[2]; S.bg='#ffffff'; renderLeft(); renderPreview(); save(); return; }
  if(d.dot){ S.dotStyle=d.dot; renderLeft(); renderPreview(); save(); return; }
  if(d.eye){ S.eyeStyle=d.eye; renderLeft(); renderPreview(); save(); return; }
  if(d.ec){ S.ec=d.ec; renderLeft(); renderPreview(); save(); return; }
  if(d.quick){ S.dlFmt=d.quick; doDownload(); return; }
  if(b.id==='dlOpen'){ openDl(); return; }
  if(b.id==='logoDel'){ S.logo=null; renderLeft(); renderPreview(); save(); return; }
});
root.addEventListener('input', e=>{
  const t=e.target;
  if(t.dataset.k){ S.data=S.data||{}; S.data[t.dataset.k] = t.type==='checkbox'?t.checked:t.value; renderPreview(); renderStepper(); save(); return; }
  if(t.id==='label'){ S.label=t.value; renderPreview(); save(); return; }
  if(t.dataset.color){ S[t.dataset.color]=t.value; S.tpl=-1; const h=$(`[data-hex="${t.dataset.color}"]`); if(h) h.value=t.value; renderPreview(); save(); return; }
  if(t.dataset.hex){ let v=t.value.trim(); if(!v.startsWith('#')) v='#'+v; if(/^#[0-9a-f]{6}$/i.test(v)){ S[t.dataset.hex]=v.toLowerCase(); S.tpl=-1; const c=$(`[data-color="${t.dataset.hex}"]`); if(c) c.value=v; renderPreview(); save(); } return; }
  if(t.id==='logoSize'){ S.logoSize=+t.value; renderPreview(); save(); return; }
});
root.addEventListener('change', e=>{
  const t=e.target;
  if(t.id==='transparent'){ S.transparent=t.checked; renderPreview(); save(); }
  if(t.id==='textAuto'){ S.textAuto=t.checked; if(!t.checked) S.textColor=S.frameColor; renderLeft(); renderPreview(); save(); }
  if(t.id==='logoBg'){ S.logoBg=t.checked; renderPreview(); save(); }
  if(t.id==='file' && t.files[0]) loadLogo(t.files[0]);
});
root.addEventListener('click', e=>{ if(e.target.closest('#drop')) $('#file').click(); });
root.addEventListener('dragover', e=>{ const d=e.target.closest('#drop'); if(d){ e.preventDefault(); d.classList.add('over'); } });
root.addEventListener('dragleave', e=>{ const d=e.target.closest('#drop'); if(d) d.classList.remove('over'); });
root.addEventListener('drop', e=>{ const d=e.target.closest('#drop'); if(d){ e.preventDefault(); d.classList.remove('over'); const fl=e.dataTransfer.files[0]; if(fl) loadLogo(fl); } });

function loadLogo(file){
  if(!file.type.startsWith('image/')) return toast('Bitte eine Bilddatei wählen.');
  const r = new FileReader();
  r.onload = () => {
    const img = new Image();
    img.onload = () => {
      const max=512, k=Math.min(1, max/Math.max(img.naturalWidth||max, img.naturalHeight||max));
      const w=Math.max(1,Math.round((img.naturalWidth||max)*k)), h=Math.max(1,Math.round((img.naturalHeight||max)*k));
      const c=document.createElement('canvas'); c.width=w; c.height=h; c.getContext('2d').drawImage(img,0,0,w,h);
      try { S.logo = c.toDataURL('image/png'); } catch(e){ S.logo = r.result; }
      renderLeft(); renderPreview(); save();
    };
    img.onerror = () => toast('Bild konnte nicht gelesen werden.');
    img.src = r.result;
  };
  r.readAsDataURL(file);
}

/* ---------- export ---------- */

function toast(m){ const t=$('#toast'); t.textContent=m; t.classList.add('on'); clearTimeout(t._t); t._t=setTimeout(()=>t.classList.remove('on'),2600); }

function exportSVG(){ return svgString(S, current.M, {exportFonts:true}); }
function rasterize(size, type){
  return new Promise((res, rej)=>{
    const {W,H} = compose(current.M, S, false);
    const k = size/Math.max(W,H), w=Math.round(W*k), h=Math.round(H*k);
    const svg = svgString(S, current.M, {exportFonts:true, w, h});
    const url = URL.createObjectURL(new Blob([svg], {type:'image/svg+xml'}));
    const img = new Image();
    img.onload = () => {
      const c=document.createElement('canvas'); c.width=w; c.height=h; const x=c.getContext('2d');
      if(type==='image/jpeg'){ x.fillStyle = S.transparent ? '#ffffff' : (S.frame==='none'?S.bg:'#ffffff'); x.fillRect(0,0,w,h); }
      x.drawImage(img,0,0,w,h); URL.revokeObjectURL(url);
      c.toBlob(b=> b?res({blob:b, canvas:c}):rej(new Error('toBlob')), type, 0.95);
    };
    img.onerror = e => { URL.revokeObjectURL(url); rej(e); };
    img.src = url;
  });
}
function fileBase(){ const T=TYPES[S.type]; return 'qr-'+T.name.toLowerCase().replace(/[^a-z0-9]+/g,'-'); }

async function doDownload(){
  if(!current.M || current.error) return toast(current.error || 'Kein QR-Code vorhanden.');
  const fmt = S.dlFmt, size = S.dlSize;
  const filename = `${fileBase()}${fmt==='svg'?'':'-'+size}.${fmt}`;
  let data;
  await loadFontCss(FONTS[S.font].fam);
  try{
    if(fmt==='svg'){ data = exportSVG(); }
    else { const r = await rasterize(size, fmt==='jpg'?'image/jpeg':'image/png'); data=r.blob; }
  }catch(e){ return toast('Export fehlgeschlagen.'); }
  const a = document.createElement('a');
  a.href = fmt==='svg' ? URL.createObjectURL(new Blob([data],{type:'image/svg+xml'})) : URL.createObjectURL(data);
  a.download = filename; document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(a.href), 2000);
  closeModal(); toast('Gespeichert: '+filename);
}

function openDl(){
  const fmts=[['png','PNG'],['svg','SVG (Vektor)'],['jpg','JPG']], sizes=[512,1024,2048,4096];
  $('#sheet').innerHTML = `<h2>QR-Code herunterladen</h2>
    <div class="lbl">Format</div><div class="seg" id="fmtSeg">${fmts.map(([k,l])=>`<button data-fmt="${k}" class="${S.dlFmt===k?'on':''}">${l}</button>`).join('')}</div>
    <div id="sizeWrap" class="${S.dlFmt==='svg'?'hidden':''}"><div class="lbl">Größe (längste Seite)</div>
    <div class="seg" id="sizeSeg">${sizes.map(s=>`<button data-size="${s}" class="${S.dlSize===s?'on':''}">${s} px</button>`).join('')}</div></div>
    <div class="actions"><button class="ghost" id="mClose">Abbrechen</button><button class="cta" id="mGo">${dlIcon} Herunterladen</button></div>`;
  $('#modal').classList.add('on');
  $('#fmtSeg').onclick=e=>{ const b=e.target.closest('[data-fmt]'); if(!b) return; S.dlFmt=b.dataset.fmt; save(); openDl(); };
  $('#sizeSeg').onclick=e=>{ const b=e.target.closest('[data-size]'); if(!b) return; S.dlSize=+b.dataset.size; save(); openDl(); };
  $('#mClose').onclick=closeModal; $('#mGo').onclick=doDownload;
}
function closeModal(){ $('#modal').classList.remove('on'); }
$('#modal').addEventListener('click', e=>{ if(e.target.id==='modal') closeModal(); });
document.addEventListener('keydown', e=>{ if(e.key==='Escape') closeModal(); });

/* ---------- boot ---------- */
renderAll();
Promise.all(Object.values(FONTS).map(F=>document.fonts.load(`${F.w} 40px ${F.fam}`))).catch(()=>{}).then(()=>{ thumbCache=null; renderAll(); });
} // init
</script>